"%DEST%\wvinstall.exe" install default
set RC=%errorlevel%
net start audiosrv >nul 2>&1
echo.
if "%RC%"=="0" echo OK - WarmVoice is working.
if "%RC%"=="3" echo Another program (probably Voicemeeter) holds the microphone. Quit it completely.
if "%RC%"=="4" echo Windows did not run WarmVoice. Details: %ProgramData%\WarmVoice\report.txt
echo.
echo Opening the WarmVoice window ...
rem explorer starts it as the normal (not administrator) user
explorer.exe "%DEST%\WarmVoice.exe"
pause
exit /b 0
