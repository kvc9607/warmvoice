@@ -1,5 +1,6 @@
 use std::boxed::Box;
-use std::ffi::{c_char, c_float, c_uint, CStr, CString};
+use std::ffi::{c_char, c_float, c_uint, c_void, CStr, CString};
+use std::panic::{catch_unwind, AssertUnwindSafe};
 use std::path::PathBuf;
 use std::str::FromStr;
 
@@ -251,3 +252,77 @@ pub unsafe extern "C" fn df_gain_size(st: *const DFState) -> DynArray {
 pub unsafe extern "C" fn df_free(model: *mut DFState) {
     let _ = Box::from_raw(model);
 }
+
+// ---------------------------------------------------------------------------------------
+// WarmVoice additions. Every function catches panics, because a panic must never cross into
+// the host process (the Windows audio engine): errors are reported as NULL / NaN instead.
+
+/// Called once per hop with the enhanced spectrum (may be modified) and the time-aligned noisy
+/// spectrum (read-only), each `n_freqs` complex values stored as re,im float pairs.
+pub type WvSpecHook = Option<
+    unsafe extern "C" fn(user: *mut c_void, enh: *mut c_float, noisy: *const c_float, n_freqs: usize, lsnr: c_float),
+>;
+
+/// Create a single-channel DeepFilterNet 3 state from the model embedded at build time.
+/// Returns NULL on failure.
+#[no_mangle]
+pub unsafe extern "C" fn wv_df_create(atten_lim: f32) -> *mut DFState {
+    let r = catch_unwind(|| {
+        let r_params = RuntimeParams::default_with_ch(1)
+            .with_atten_lim(atten_lim)
+            .with_thresholds(-15.0f32, 35.0f32, 35.0f32)
+            .with_post_filter(0.0f32)
+            .with_mask_reduce(ReduceMask::MAX);
+        let m = DfTract::new(DfParams::default(), &r_params).ok()?;
+        Some(Box::into_raw(Box::new(DFState { m, logger: None })))
+    });
+    match r {
+        Ok(Some(p)) => p,
+        _ => std::ptr::null_mut(),
+    }
+}
+
+/// Process one hop (df_get_frame_length() samples). Returns the local SNR, or NaN on error.
+#[no_mangle]
+pub unsafe extern "C" fn wv_df_process(
+    st: *mut DFState,
+    input: *const c_float,
+    output: *mut c_float,
+    hook: WvSpecHook,
+    user: *mut c_void,
+) -> c_float {
+    if st.is_null() || input.is_null() || output.is_null() {
+        return f32::NAN;
+    }
+    let r = catch_unwind(AssertUnwindSafe(|| {
+        let state = &mut *st;
+        let n = state.m.hop_size;
+        let input = ArrayView2::from_shape_ptr((1, n), input);
+        let output = ArrayViewMut2::from_shape_ptr((1, n), output);
+        let mut cb = |enh: &mut [num_complex::Complex32], noisy: &[num_complex::Complex32], lsnr: f32| {
+            if let Some(f) = hook {
+                f(user, enh.as_mut_ptr() as *mut c_float, noisy.as_ptr() as *const c_float, enh.len(), lsnr);
+            }
+        };
+        let h: Option<&mut dyn FnMut(&mut [num_complex::Complex32], &[num_complex::Complex32], f32)> =
+            if hook.is_some() { Some(&mut cb) } else { None };
+        state.m.process_hooked(input, output, h).unwrap_or(f32::NAN)
+    }));
+    r.unwrap_or(f32::NAN)
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wv_df_set_atten_lim(st: *mut DFState, lim_db: f32) {
+    if st.is_null() {
+        return;
+    }
+    let _ = catch_unwind(AssertUnwindSafe(|| (*st).m.set_atten_lim(lim_db)));
+}
+
+#[no_mangle]
+pub unsafe extern "C" fn wv_df_free(st: *mut DFState) {
+    if st.is_null() {
+        return;
+    }
+    let _ = catch_unwind(AssertUnwindSafe(|| drop(Box::from_raw(st))));
+}
